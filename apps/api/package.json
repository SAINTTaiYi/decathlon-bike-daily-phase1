{
  "name": "@bike-ops/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/start.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "predev": "node ../../scripts/generate-build-metadata.mjs && pnpm --filter @bike-ops/contracts build && pnpm --filter @bike-ops/database build",
    "pretest": "node ../../scripts/generate-build-metadata.mjs && pnpm --filter @bike-ops/contracts build && pnpm --filter @bike-ops/database build",
    "pretypecheck": "node ../../scripts/generate-build-metadata.mjs",
    "prebuild": "node ../../scripts/generate-build-metadata.mjs && pnpm --filter @bike-ops/contracts build && pnpm --filter @bike-ops/database build"
  },
  "dependencies": {
    "@bike-ops/contracts": "workspace:*",
    "@bike-ops/database": "workspace:*",
    "@bike-ops/domain": "workspace:*",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@node-rs/argon2": "2.0.2",
    "@supabase/supabase-js": "2.110.5",
    "fastify": "4.29.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
