# Web — VITE_ values are embedded in browser assets.
# Leave VITE_API_BASE_URL empty on EdgeOne so Web and Cloud Functions stay same-origin.
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_ENABLE_SERVICE_WORKER=false

# API runtime — never expose these with VITE_ prefixes.
APP_ENV=local
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=15
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-at-least-32-random-bytes
CONTACT_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
TRUST_PROXY=false

# APP_VERSION and GIT_SHA are generated from package.json and Git during build.
# Do not configure stale APP_VERSION/GIT_SHA overrides in EdgeOne.

# Platform administrator bootstrap — store only a SHA-256 hex digest here.
# The one-time #platform-admin=<token> flow creates the fixed CHU13 platform role.
# Generate locally, for example: printf '%s' '<temporary-token>' | sha256sum
PLATFORM_ADMIN_SETUP_TOKEN_HASH=

# Self-service registration mail — Worker/server only.
# REGISTRATION_SECRET must be at least 32 bytes; RESEND_API_KEY must never use a VITE_ prefix.
REGISTRATION_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=
RESEND_FROM=Workshop Bike Ops <noreply@work2die.asia>

# Supabase private Storage — API server only; leave blank to disable attachment routes locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bike-ops-media

# Migration-only connection — used by local/GitHub migration jobs, never by EdgeOne runtime.
# Use the Supavisor session pooler on port 5432 with sslmode=require.
MIGRATION_DATABASE_URL=

# EdgeOne Staging/Production projects use the same runtime names above with isolated values.
# GitHub Environment configuration is intentionally smaller:
#   Secret: MIGRATION_DATABASE_URL
#   Variable: EDGEONE_SITE_URL
# Never commit or paste real database URLs, secret keys, passwords, peppers, or encryption keys.


# --- Cloudflare Workers / D1 (staging) ---
# Set as Worker secrets via dashboard or `wrangler secret put` — never commit values.
# SESSION_SECRET=
# CSRF_SECRET=
# PASSWORD_PEPPER=
# CONTACT_ENCRYPTION_KEY=
# PLATFORM_ADMIN_SETUP_TOKEN_HASH=
# REGISTRATION_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Workshop Bike Ops <noreply@work2die.asia>
# CORS_ALLOWED_ORIGINS=https://bike-ops-staging.<subdomain>.workers.dev
# APP_ENV=staging
# COOKIE_SECURE=true
# SESSION_TTL_HOURS=12
