# Web — values with VITE_ prefixes are exposed to the browser
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_APP_ENV=local
VITE_ENABLE_SERVICE_WORKER=false

# API runtime — never expose these with VITE_ prefixes
APP_ENV=local
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-at-least-32-random-bytes
CONTACT_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
TRUST_PROXY=false
APP_VERSION=5.2.10
GIT_SHA=local

# First administrator — store only a SHA-256 hex digest here
# Generate locally, for example: printf '%s' '<temporary-token>' | sha256sum
ADMIN_SETUP_TOKEN_HASH=

# R2 — API server only; leave blank to disable attachment routes locally
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Ops bootstrap/release variables are environment-specific in CI.
# Do not place real cloud credentials in a committed file.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# RAILWAY_API_TOKEN=
# RAILWAY_WORKSPACE_ID=
# RAILWAY_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_ORG_SLUG=
# SUPABASE_DB_PASSWORD_STAGING=
# SESSION_SECRET_STAGING=
# CSRF_SECRET_STAGING=
# PASSWORD_PEPPER_STAGING=
# CONTACT_ENCRYPTION_KEY_STAGING=
# INITIAL_ADMIN_SETUP_TOKEN_STAGING=
# R2_ACCESS_KEY_ID_STAGING=
# R2_SECRET_ACCESS_KEY_STAGING=
# CUSTOM_WEB_ORIGINS_STAGING=
#
# Production uses the same names with the _PRODUCTION suffix.
